---
import '../styles/global.css';
import Preloader from '../components/Preloader.astro';
import PortfolioCanvas from '../components/PortfolioCanvas';
import HeroText from '../components/ui/HeroText';
import CustomCursor from '../components/cursor/CustomCursor';
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Your Name — Web Designer &amp; Developer</title>
    <meta name="description" content="Creo siti web con cura maniacale. Design, performance, animazioni." />
    <meta property="og:title" content="Your Name — Web Designer & Developer" />
    <meta property="og:description" content="Creo siti web con cura maniacale." />
    <meta property="og:image" content="/og-image.jpg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body>
    <!-- Preloader: visible immediately, no JS framework needed -->
    <Preloader />

    <!-- Scroll spacer — 600vh gives the scroll mapping room -->
    <div style="height: 600vh; position: relative; z-index: 1;" />

    <!-- R3F canvas mounted as React island -->
    <PortfolioCanvas client:load />

    <!-- UI overlays -->
    <HeroText client:load />
    <CustomCursor client:load />

    <!-- Fallback for no JS / no WebGL -->
    <noscript>
      <div style="color:#F0EBE1;background:#0A0A0F;padding:4rem;font-family:monospace;text-align:center;">
        <p>Abilita JavaScript per l'esperienza completa.</p>
      </div>
    </noscript>
  </body>
</html>
