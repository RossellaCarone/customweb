---
// Preloader.astro — pure CSS/JS, no Three.js dependency
// Hides the page while R3F initialises in background.
---

<div id="preloader">
  <canvas id="preloader-canvas"></canvas>
  <div id="preloader-name"></div>
</div>

<style>
  #preloader {
    position: fixed;
    inset: 0;
    background: #0A0A0F;
    z-index: 1000;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2rem;
  }

  #preloader-canvas {
    width: 320px;
    height: 2px;
    display: block;
  }

  #preloader-name {
    font-family: 'DM Mono', monospace;
    font-size: clamp(0.65rem, 2vw, 0.85rem);
    letter-spacing: 0.55em;
    color: #F0EBE1;
    text-transform: uppercase;
    min-height: 1.2em;
  }
</style>

<script>
  (function () {
    const preloader = document.getElementById('preloader')!;
    const canvas = document.getElementById('preloader-canvas') as HTMLCanvasElement;
    const nameEl = document.getElementById('preloader-name')!;

    // Hi-DPI canvas
    const W = 320, H = 2;
    const dpr = window.devicePixelRatio || 1;
    canvas.width = W * dpr;
    canvas.height = 8 * dpr;
    canvas.style.height = '8px';
    const ctx = canvas.getContext('2d')!;
    ctx.scale(dpr, dpr);

    const NAME = 'YOUR NAME'; // ← replace with your actual name
    const CHARS = NAME.split('').map((c) => (c === ' ' ? '\u00A0' : c));
    const DURATION = 1600; // ms
    let start: number | null = null;
    let nameIndex = 0;
    let nameTimer = 0;

    function drawLine(progress: number) {
      ctx.clearRect(0, 0, W, 8);
      // gold line
      const grad = ctx.createLinearGradient(0, 0, W, 0);
      grad.addColorStop(0, '#C8A96E');
      grad.addColorStop(1, '#F0EBE1');
      ctx.fillStyle = grad;
      ctx.fillRect(0, 3, W * progress, 2);

      // flash at 100%
      if (progress >= 1) {
        ctx.fillStyle = `rgba(255,255,255,${(progress - 1) * 0 + 0.9})`;
        ctx.fillRect(0, 0, W, 8);
      }
    }

    function frame(ts: number) {
      if (!start) start = ts;
      const elapsed = ts - start;
      const progress = Math.min(elapsed / DURATION, 1);

      drawLine(progress);

      // counter overlay — handled via CSS content trick; we use nameEl for the number
      // type name character by character
      if (elapsed > nameTimer && nameIndex < CHARS.length) {
        nameEl.textContent += CHARS[nameIndex];
        nameIndex++;
        nameTimer = elapsed + 40;
      }

      if (progress < 1) {
        requestAnimationFrame(frame);
      } else {
        // flash → fade out
        setTimeout(() => {
          preloader.style.transition = 'opacity 0.5s ease';
          preloader.style.opacity = '0';
          setTimeout(() => {
            preloader.style.display = 'none';
          }, 500);
        }, 200);
      }
    }

    requestAnimationFrame(frame);
  })();
</script>
